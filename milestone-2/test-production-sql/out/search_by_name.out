('base1-1','Base','Base','WOTC','First','1/9/1999','Ken Sugimori','Alakazam',1,'[\'Psychic\']','Pokémon','[\'Stage 2\']',42,80,'Kadabra',NULL,'[{\'name\': \'Damage Swap\', \'text\': \"As often as you like during your turn (before your attack), you may move 1 damage counter from 1 of your Pokémon to another as long as you don\'t Knock Out that Pokémon. This power can\'t be used if Alakazam is Asleep, Confused, or Paralyzed.\", \'type\': \'Pokémon Power\'}]','[{\'name\': \'Confuse Ray\', \'cost\': [\'Psychic\', \'Psychic\', \'Psychic\'], \'convertedEnergyCost\': 3, \'damage\': \'30\', \'text\': \'Flip a coin. If heads, the Defending Pokémon is now Confused.\'}]','[{\'type\': \'Psychic\', \'value\': \'×2\'}]','[\'Colorless\', \'Colorless\', \'Colorless\']',3,'Rare Holo','Its brain can outperform a supercomputer. Its intelligence quotient is said to be 5000.','[65]','{\'unlimited\': \'Legal\'}',NULL,NULL,NULL,NULL)
